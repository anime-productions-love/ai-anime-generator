{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anime Story Generator Sequence Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "story_id",
    "sequence_id",
    "shots",
    "selected_shot_id",
    "current_character_ids",
    "current_scene_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "story_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "sequence_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "shots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4,}$"
      }
    },
    "selected_shot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_character_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
      }
    },
    "current_scene_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
