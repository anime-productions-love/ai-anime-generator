{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anime Story Generator Style Preset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "name",
    "prompt_prefix",
    "negative_prompt",
    "linework",
    "shading",
    "palette"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "kind": {
      "const": "style"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "prompt_prefix": {
      "type": "string"
    },
    "negative_prompt": {
      "type": "string"
    },
    "linework": {
      "type": "string"
    },
    "shading": {
      "type": "string"
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
