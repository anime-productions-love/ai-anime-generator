{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anime Story Generator Shot Manifest v2 (compatible with schema_version v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "story_id",
    "sequence_id",
    "shot_id",
    "prompt",
    "composed_prompt",
    "composed_negative_prompt",
    "characters",
    "scene_id",
    "style_id",
    "asset_revisions",
    "reference_images",
    "continuity_from_shot",
    "conditioning_image",
    "conditioning_source",
    "conditioning_strength",
    "model_id",
    "backend",
    "width",
    "height",
    "steps",
    "cfg",
    "seed",
    "candidates",
    "selected_candidate",
    "selected_image",
    "selected_sha256",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "story_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "sequence_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^[0-9]{4,}$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "composed_prompt": {
      "type": "string",
      "minLength": 1
    },
    "composed_negative_prompt": {
      "type": "string"
    },
    "characters": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
      }
    },
    "scene_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "style_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "asset_revisions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "reference_images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "asset_id",
          "role",
          "path",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "character",
              "scene"
            ]
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          },
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "continuity_from_shot": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditioning_image": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditioning_source": {
      "type": "string"
    },
    "conditioning_strength": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "model_id": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 256,
      "maximum": 1536,
      "multipleOf": 8
    },
    "height": {
      "type": "integer",
      "minimum": 256,
      "maximum": 1536,
      "multipleOf": 8
    },
    "steps": {
      "type": "integer",
      "minimum": 4,
      "maximum": 100
    },
    "cfg": {
      "type": "number",
      "minimum": 1,
      "maximum": 15
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "path",
          "sha256"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "selected_candidate": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "selected_image": {
      "type": "string"
    },
    "selected_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "guidance": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "base",
            "ip-adapter",
            "controlnet",
            "both"
          ]
        },
        "ip_adapter_references": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "control_reference": {
          "type": [
            "object",
            "null"
          ]
        },
        "character_loras": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "continuity_evaluation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "description": "Phase 3 optional identity and layout guidance plus advisory visual similarity, backwards compatible with Phase 2 shot manifests."
}
